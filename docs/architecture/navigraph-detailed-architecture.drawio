<mxCell id="ds-azuread" value="Azure AD (Entra ID) — external IdP&#10;JWKS: login.microsoftonline.com/{tenant}/discovery/v2.0/keys&#10;STATUS: mechanism ready, not wired to a live tenant" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;align=center;verticalAlign=middle;dashed=1;" vertex="1" parent="1"><mxGeometry x="1460" y="1095" width="340" height="100" as="geometry" /></mxCell>
