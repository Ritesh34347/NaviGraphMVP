<mxCell id="title" value="NaviGraph — Detailed Technical Architecture (as of 2026-08-06)" style="text;html=1;fontSize=20;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="550" y="10" width="1050" height="30" as="geometry" /></mxCell>
<mxCell id="subtitle" value="Multi-tenant conversational BI platform — 25 real agents across 6 domains, 3 connectors, MCP + REST entry points" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="550" y="45" width="1050" height="22" as="geometry" /></mxCell>
<mxCell id="l1" value="LAYER 1 — CLIENTS" style="text;html=1;fontSize=13;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="90" width="500" height="20" as="geometry" /></mxCell>
<mxCell id="client-web" value="Web Browser&#10;End-user chat UI (Next.js SSR/CSR)&#10;HTTPS / JSON over REST" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="120" width="340" height="70" as="geometry" /></mxCell>
<mxCell id="client-agent" value="Headless Client / Script&#10;Direct HTTP&#10;HTTPS / JSON over REST" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="430" y="120" width="340" height="70" as="geometry" /></mxCell>
<mxCell id="client-mcp" value="MCP Client (Claude, custom agent harness)&#10;JSON-RPC 2.0 over Streamable-HTTP (mcp&gt;=1,&lt;2 SDK)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="800" y="120" width="340" height="70" as="geometry" /></mxCell>
<mxCell id="l2" value="LAYER 2 — INGRESS &amp; APPLICATION" style="text;html=1;fontSize=13;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="215" width="500" height="20" as="geometry" /></mxCell>
<mxCell id="ingress" value="ingress-nginx + cert-manager&#10;TLS termination (Let&#x27;s Encrypt) · canary weight routing (nginx.ingress.kubernetes.io/canary)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#F5F5F5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="430" y="245" width="500" height="60" as="geometry" /></mxCell>
<mxCell id="web-app" value="Web App — Next.js (App Router, TypeScript)&#10;web-stable / web-canary Deployments&#10;Data-source dropdown (Fidelity / E-commerce)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="150" y="335" width="340" height="90" as="geometry" /></mxCell>
<mxCell id="gateway" value="Gateway — FastAPI (Python 3.11)&#10;gateway-stable / gateway-canary Deployments&#10;POST /ask · /mcp (5 MCP tools) · /healthz · /readyz · /metrics" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="550" y="335" width="460" height="90" as="geometry" /></mxCell>
<mxCell id="azuread-note" value="Identity middleware: _verify_identity (FastAPI Depends)&#10;navigraph_shared.auth.azure_ad — RS256 JWT/JWKS via PyJWT&#10;STATUS: built + tested, azure_ad_enabled=False (OFF)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;align=center;verticalAlign=middle;dashed=1;" vertex="1" parent="1"><mxGeometry x="1060" y="335" width="420" height="90" as="geometry" /></mxCell>
<mxCell id="l3" value="LAYER 3 — AGENT RUNTIME (FastAPI, Python 3.11, single deployment — 25 agents, each independently HTTP-invokable)" style="text;html=1;fontSize=13;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="460" width="1400" height="20" as="geometry" /></mxCell>
<mxCell id="dom-orch" value="Orchestrator Domain (3) — pipeline conductor" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#FFF2CC;strokeColor=#D6B656;verticalAlign=top;align=center;spacingTop=6;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="490" width="1900" height="150" as="geometry" /></mxCell>
<mxCell id="orch-1" value="Request Orchestrator&#10;~19-stage pipeline conductor · auto-resolves data_source_id · threads lineage" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="90" y="540" width="620" height="70" as="geometry" /></mxCell>
<mxCell id="orch-2" value="Session / Context Manager&#10;Redis-backed · sliding 1800s TTL · multi-turn history" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="740" y="540" width="590" height="70" as="geometry" /></mxCell>
<mxCell id="orch-3" value="Clarification Coordinator&#10;LLM-backed · triggers on 0 resolved tables · generates real clarifying Q" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1360" y="540" width="570" height="70" as="geometry" /></mxCell>
<mxCell id="dom-und" value="Understanding Domain (6)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#DAE8FC;strokeColor=#6C8EBF;verticalAlign=top;align=center;spacingTop=6;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="665" width="340" height="390" as="geometry" /></mxCell>
<mxCell id="u1" value="1. Conversation — LLM rewrite of follow-ups (skips LLM if no history)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="75" y="705" width="310" height="46" as="geometry" /></mxCell>
<mxCell id="u2" value="2. Intent Understanding — classifies IntentLabel + extracts entities" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="75" y="759" width="310" height="46" as="geometry" /></mxCell>
<mxCell id="u3" value="3. Metadata Discovery — real catalog inventory (Postgres)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="75" y="813" width="310" height="46" as="geometry" /></mxCell>
<mxCell id="u4" value="4. Ontology — Neo4j exact + fuzzy (token-based) term resolution" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="75" y="867" width="310" height="46" as="geometry" /></mxCell>
<mxCell id="u5" value="5. Semantic Retrieval — LLM fallback, closed candidate list only" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="75" y="921" width="310" height="46" as="geometry" /></mxCell>
<mxCell id="u6" value="6. Schema Mapping — assembles tables/columns/joins + roles" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="75" y="975" width="310" height="46" as="geometry" /></mxCell>
<mxCell id="dom-qry" value="Query Domain (6)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#D5E8D4;strokeColor=#82B366;verticalAlign=top;align=center;spacingTop=6;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="420" y="665" width="340" height="390" as="geometry" /></mxCell>
<mxCell id="q1" value="1. Data Source Discovery — resolves owning DataSource + health check" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="435" y="705" width="310" height="46" as="geometry" /></mxCell>
<mxCell id="q2" value="2. SQL Generation — deterministic builder + LLM predicate resolution" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="435" y="759" width="310" height="46" as="geometry" /></mxCell>
<mxCell id="q3" value="3. SQL Optimization — LIMIT injection, audit comment, cost warnings" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="435" y="813" width="310" height="46" as="geometry" /></mxCell>
<mxCell id="q4" value="4. Execution Planning — real SQL parse, SELECT-only safety gate" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="435" y="867" width="310" height="46" as="geometry" /></mxCell>
<mxCell id="q5" value="5. Data Federation — executes (direct connector or Trino route)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="435" y="921" width="310" height="46" as="geometry" /></mxCell>
<mxCell id="q6" value="6. Caching — Redis, tenant-prefixed versioned keys, 5 min TTL" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="435" y="975" width="310" height="46" as="geometry" /></mxCell>
<mxCell id="dom-grd" value="Guardrail Domain (4)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#F8CECC;strokeColor=#B85450;verticalAlign=top;align=center;spacingTop=6;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="780" y="665" width="340" height="390" as="geometry" /></mxCell>
<mxCell id="g1" value="1. Schema Constraint Validator — verifies tables/columns exist" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#F8CECC;strokeColor=#B85450;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="795" y="705" width="310" height="46" as="geometry" /></mxCell>
<mxCell id="g2" value="2. Policy Authorization — real OPA/Rego RBAC+ABAC (authz.rego)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#F8CECC;strokeColor=#B85450;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="795" y="759" width="310" height="46" as="geometry" /></mxCell>
<mxCell id="g3" value="3. Query Cost / Row-Limit Estimator — per-role row caps" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#F8CECC;strokeColor=#B85450;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="795" y="813" width="310" height="46" as="geometry" /></mxCell>
<mxCell id="g4" value="4. PII Exposure Checker — denies un-authorized PII column access" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#F8CECC;strokeColor=#B85450;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="795" y="867" width="310" height="46" as="geometry" /></mxCell>
<mxCell id="dom-ins" value="Insight Domain (4)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#E1D5E7;strokeColor=#9673A6;verticalAlign=top;align=center;spacingTop=6;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1140" y="665" width="340" height="390" as="geometry" /></mxCell>
<mxCell id="i1" value="1. Chart Selection — deterministic bar/line/table/single-value" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1155" y="705" width="310" height="46" as="geometry" /></mxCell>
<mxCell id="i2" value="2. Anomaly / Outlier Highlighter — stdlib z-score, no LLM" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1155" y="759" width="310" height="46" as="geometry" /></mxCell>
<mxCell id="i3" value="3. Grounded Narrative Generation — LLM + citation verification" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1155" y="813" width="310" height="46" as="geometry" /></mxCell>
<mxCell id="i4" value="4. Follow-up Suggestion — LLM-generated next-question proposals" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1155" y="867" width="310" height="46" as="geometry" /></mxCell>
<mxCell id="dom-ops" value="Ops Domain (2)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#FFE6CC;strokeColor=#D79B00;verticalAlign=top;align=center;spacingTop=6;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1500" y="665" width="340" height="390" as="geometry" /></mxCell>
<mxCell id="o1" value="1. Lineage Recorder — appends LineageEvent to Postgres (idempotent)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1515" y="705" width="310" height="46" as="geometry" /></mxCell>
<mxCell id="o2" value="2. Evaluation Judge — LLM-as-judge (correctness/groundedness/quality)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1515" y="759" width="310" height="46" as="geometry" /></mxCell>
<mxCell id="conn-note" value="connector_sdk&#10;Connector ABC:&#10;test_connection()&#10;introspect_schema()&#10;execute_query()&#10;capabilities()" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#F5F5F5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1860" y="665" width="250" height="390" as="geometry" /></mxCell>
<mxCell id="l4" value="LAYER 4 — DATA STORES &amp; POLICY ENGINE" style="text;html=1;fontSize=13;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="1067" width="700" height="20" as="geometry" /></mxCell>
