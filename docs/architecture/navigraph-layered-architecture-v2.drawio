<mxCell id="dtitle" value="NaviGraph — Layer-by-Layer Architecture" style="text;html=1;fontSize=22;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="60" y="10" width="1400" height="34" as="geometry" /></mxCell>
<mxCell id="dsubtitle" value="How a question travels from raw company data (left) to an answer for the user (right)" style="text;html=1;fontSize=13;align=left;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="60" y="46" width="1500" height="24" as="geometry" /></mxCell>
<mxCell id="sources" value="1. DATA SOURCES" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#D5E8D4;strokeColor=#82B366;verticalAlign=top;align=center;spacingTop=6;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="60" y="150" width="320" height="408" as="geometry" /></mxCell>
<mxCell id="sources-purpose" value="Where the company&#x27;s real data already lives" style="text;html=1;fontSize=11;fontStyle=2;align=center;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="76" y="182" width="288" height="42" as="geometry" /></mxCell>
<mxCell id="sources-0" value="Snowflake&#10;CONNECTED — live brokerage &amp; e-commerce data" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#82B366;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="76" y="228" width="288" height="44" as="geometry" /></mxCell>
<mxCell id="sources-1" value="PostgreSQL&#10;connector built &amp; tested — ready to point at a real instance" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#82B366;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="76" y="282" width="288" height="44" as="geometry" /></mxCell>
<mxCell id="sources-2" value="Databricks&#10;connector built &amp; tested — ready to point at a real instance" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#82B366;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="76" y="336" width="288" height="44" as="geometry" /></mxCell>
<mxCell id="connectors" value="2. CONNECTOR LAYER" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#F5F5F5;strokeColor=#666666;verticalAlign=top;align=center;spacingTop=6;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="530" y="150" width="320" height="408" as="geometry" /></mxCell>
<mxCell id="connectors-purpose" value="Speaks every source&#x27;s native language, so nothing downstream has to" style="text;html=1;fontSize=11;fontStyle=2;align=center;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="546" y="182" width="288" height="42" as="geometry" /></mxCell>
<mxCell id="connectors-0" value="One shared interface&#10;test connection · read schema · run query · report capabilities" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="546" y="228" width="288" height="44" as="geometry" /></mxCell>
<mxCell id="connectors-1" value="Add a new source&#10;= write one connector — no changes needed anywhere else" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="546" y="282" width="288" height="44" as="geometry" /></mxCell>
<mxCell id="storage" value="3. STORAGE &amp; KNOWLEDGE" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#DAE8FC;strokeColor=#6C8EBF;verticalAlign=top;align=center;spacingTop=6;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1000" y="150" width="320" height="408" as="geometry" /></mxCell>
<mxCell id="storage-purpose" value="Remembers what the data means, not just what it contains" style="text;html=1;fontSize=11;fontStyle=2;align=center;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1016" y="182" width="288" height="42" as="geometry" /></mxCell>
<mxCell id="storage-0" value="Metadata Catalog&#10;PostgreSQL — every table &amp; column, tagged with business names + PII flags" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#6C8EBF;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1016" y="228" width="288" height="44" as="geometry" /></mxCell>
<mxCell id="storage-1" value="Knowledge Graph&#10;Neo4j — how business concepts (e.g. “revenue”) map to real tables" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#6C8EBF;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1016" y="282" width="288" height="44" as="geometry" /></mxCell>
<mxCell id="storage-2" value="Cache &amp; Sessions&#10;Redis — remembers conversation history, speeds up repeat questions" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#6C8EBF;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1016" y="336" width="288" height="44" as="geometry" /></mxCell>
<mxCell id="agents" value="4. AGENT PROCESSING" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#FFF2CC;strokeColor=#D6B656;verticalAlign=top;align=center;spacingTop=6;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1470" y="150" width="320" height="408" as="geometry" /></mxCell>
<mxCell id="agents-purpose" value="Turns a plain-English question into a correct, safe answer — step by step" style="text;html=1;fontSize=11;fontStyle=2;align=center;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1486" y="182" width="288" height="42" as="geometry" /></mxCell>
<mxCell id="agents-0" value="Orchestrator&#10;runs every step below, in order, for each question" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#D6B656;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1486" y="228" width="288" height="44" as="geometry" /></mxCell>
<mxCell id="agents-1" value="Understand (6)&#10;works out what&#x27;s being asked and which data answers it" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#D6B656;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1486" y="282" width="288" height="44" as="geometry" /></mxCell>
<mxCell id="agents-2" value="Query (6)&#10;writes the SQL and executes it" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#D6B656;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1486" y="336" width="288" height="44" as="geometry" /></mxCell>
<mxCell id="agents-3" value="Guardrail (4)&#10;checks permissions, PII, and cost — before anything runs" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#D6B656;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1486" y="390" width="288" height="44" as="geometry" /></mxCell>
<mxCell id="agents-4" value="Insight (4)&#10;builds the chart, the narrative, and flags anything unusual" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#D6B656;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1486" y="444" width="288" height="44" as="geometry" /></mxCell>
<mxCell id="agents-5" value="Ops (2)&#10;records every step for audit and quality tracking" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#D6B656;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1486" y="498" width="288" height="44" as="geometry" /></mxCell>
<mxCell id="security" value="5. SECURITY &amp; GOVERNANCE" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#F8CECC;strokeColor=#B85450;verticalAlign=top;align=center;spacingTop=6;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1940" y="150" width="320" height="408" as="geometry" /></mxCell>
<mxCell id="security-purpose" value="Nobody sees data they aren&#x27;t allowed to see" style="text;html=1;fontSize=11;fontStyle=2;align=center;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1956" y="182" width="288" height="42" as="geometry" /></mxCell>
<mxCell id="security-0" value="OPA policy engine&#10;LIVE — checks every request&#x27;s role &amp; tenant before data moves" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#B85450;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1956" y="228" width="288" height="44" as="geometry" /></mxCell>
<mxCell id="security-1" value="Azure AD identity&#10;built &amp; tested — will verify who&#x27;s really asking (not yet switched on)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#B85450;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1956" y="282" width="288" height="44" as="geometry" /></mxCell>
<mxCell id="gateway" value="6. API / GATEWAY" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#E1D5E7;strokeColor=#9673A6;verticalAlign=top;align=center;spacingTop=6;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="2410" y="150" width="320" height="408" as="geometry" /></mxCell>
<mxCell id="gateway-purpose" value="The one door every question comes through" style="text;html=1;fontSize=11;fontStyle=2;align=center;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="2426" y="182" width="288" height="42" as="geometry" /></mxCell>
<mxCell id="gateway-0" value="REST API&#10;POST /ask — for the web app and custom scripts" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#9673A6;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2426" y="228" width="288" height="44" as="geometry" /></mxCell>
