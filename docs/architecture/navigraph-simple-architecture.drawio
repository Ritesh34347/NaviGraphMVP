<mxCell id="und" value="1. Understand&#10;Works out what&#x27;s being asked and which&#10;tables/columns answer it" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="450" width="310" height="90" as="geometry" /></mxCell>
