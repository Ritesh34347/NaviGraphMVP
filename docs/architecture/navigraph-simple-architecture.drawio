<mxCell id="dsubtitle" value="One question, four automatic steps, checked at every stage before an answer comes back" style="text;html=1;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="300" y="46" width="900" height="24" as="geometry" /></mxCell>
