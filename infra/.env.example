# Copy this file to infra/.env and fill in values before running:
#   docker compose -f infra/docker-compose.yml up -d
#
# Blank values are fine for simply booting the infra stack (postgres, neo4j,
# redis, otel, prometheus, grafana, opa, trino). They only need to be filled
# in for the local-dev smoke test to exercise a real end-to-end request
# (see docs/runbooks/local-dev-smoke-test.md).

# --- Postgres ---
POSTGRES_USER=navigraph
POSTGRES_PASSWORD=changeme-local-only
POSTGRES_DB=navigraph

# --- Neo4j ---
NEO4J_PASSWORD=changeme-local-only

# --- Grafana ---
GRAFANA_ADMIN_PASSWORD=changeme-local-only

# --- Anthropic (LLM provider) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Azure AD (Entra ID) — fill in when running the real local-dev smoke
# test; blank is fine for booting the infra stack itself. ---
AZURE_AD_TENANT_ID=
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=

# --- Snowflake — fill in when running the real local-dev smoke test; blank
# is fine for booting the infra stack itself. No Trino catalog is wired to
# Snowflake yet (see LIMITATIONS.md item 3), so these are inert until then. ---
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_ROLE=
