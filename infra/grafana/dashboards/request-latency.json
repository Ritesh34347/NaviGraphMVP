{
  "id": null,
  "uid": "navigraph-request-latency",
  "title": "NaviGraph - Request Latency",
  "description": "Gateway and agent-runtime request latency, sourced from OTel HTTP server metrics via Prometheus.",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "timezone": "browser",
  "tags": ["navigraph", "latency"],
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Gateway request rate (5m)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(http_server_duration_seconds_count{job=\"gateway\"}[5m])",
          "legendFormat": "{{route}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps" },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Gateway average request duration (5m)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(http_server_duration_seconds_sum{job=\"gateway\"}[5m]) / rate(http_server_duration_seconds_count{job=\"gateway\"}[5m])",
          "legendFormat": "{{route}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s" },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Agent runtime average request duration (5m)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(http_server_duration_seconds_sum{job=\"agent-runtime\"}[5m]) / rate(http_server_duration_seconds_count{job=\"agent-runtime\"}[5m])",
          "legendFormat": "{{route}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s" },
        "overrides": []
      }
    }
  ]
}
