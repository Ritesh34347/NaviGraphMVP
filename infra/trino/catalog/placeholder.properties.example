# This file documents the SHAPE of the future real Snowflake catalog file
# and is not loaded by Trino (it does not end in .properties). Copy it to
# `snowflake.properties` in this same directory and fill in real values when
# Snowflake catalog wiring happens for real — see LIMITATIONS.md item 3.
#
# Trino auto-loads any *.properties file in this directory as a catalog, so
# do not add a real snowflake.properties here until credentials are actually
# available and network access from Trino to Snowflake has been confirmed.

connector.name=snowflake
connection-url=jdbc:snowflake://<account>.snowflakecomputing.com
connection-user=<snowflake-user>
connection-password=<snowflake-password>

# Optional but typically set for NaviGraph's tenant model:
# snowflake.warehouse=<warehouse-name>
# snowflake.database=<default-database>
# snowflake.role=<role-name>
