# This file documents the SHAPE of the future real Snowflake catalog file
# and is not loaded by Trino (it does not end in .properties). When
# Snowflake catalog wiring happens for real (see LIMITATIONS.md item 3),
# copy it to `snowflake.properties` in THIS SAME directory (and the
# matching `infra/trino/worker/catalog/` directory -- every worker needs
# the same catalog files as the coordinator) and fill in real values.
#
# Trino auto-loads any *.properties file in a node's catalog/ directory as
# a catalog, so do not add a real snowflake.properties here until
# credentials are actually available and network access from Trino to
# Snowflake has been confirmed.

connector.name=snowflake
connection-url=jdbc:snowflake://<account>.snowflakecomputing.com
connection-user=<snowflake-user>
connection-password=<snowflake-password>

# Optional but typically set for NaviGraph's tenant model:
# snowflake.warehouse=<warehouse-name>
# snowflake.database=<default-database>
# snowflake.role=<role-name>
