# --- Python ---
__pycache__/
*.py[cod]
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
.venv-*/
venv/
*.egg-info/
.eggs/
.coverage
.coverage.*
htmlcov/

# --- Node / web ---
node_modules/
.next/
out/
.turbo/
npm-debug.log*
*.tsbuildinfo
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
test-results/
playwright-report/
playwright/.cache/

# --- Terraform ---
.terraform/
*.tfstate
*.tfstate.*
*.tfstate.backup
crash.log
crash.*.log
override.tf
override.tf.json
# Real Azure credentials (subscription/tenant IDs, generated passwords) are
# written only to these -- never committed, mirroring how .env is handled.
terraform.tfvars
*.auto.tfvars
*.auto.tfvars.json
# Saved plan files (`terraform plan -out=...`) embed real planned resource
# attribute values, some in plaintext -- never committed, same as tfstate.
*.tfplan
*_override.tf
*_override.tf.json
# NOTE: .terraform.lock.hcl is intentionally NOT ignored — it should be committed
# so provider versions are reproducible across machines and CI.

# --- Env / secrets ---
.env
.env.local
.env.*.local
# Real Trino catalog files contain live connection-password values (e.g.
# infra/trino/coordinator/catalog/snowflake.properties) -- only the
# `.example` template variants are meant to be committed.
infra/trino/*/catalog/*.properties

# --- Eval harness ---
# Real run reports from `eval/run_harness.py` -- dated JSON, not meant to
# be committed; keep the directory itself via .gitkeep.
eval/results/*.json

# --- IDE ---
.vscode/
.idea/

# --- OS ---
.DS_Store
Thumbs.db

# --- Build output ---
dist/
build/

# --- Personal local overrides ---
infra/docker-compose.override.yml
